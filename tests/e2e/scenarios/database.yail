(def (p$filter column operator value)
  (call-component-method 'SupabaseDatabase1 'Filter (*list-for-runtime* column operator value) '(text text any)))
(def (p$tag name) (make-yail-dictionary (make-dictionary-pair "name" name)))
(def (p$tags tag rows)
  (call-component-method 'SupabaseDatabase1 'InsertOrSkip (*list-for-runtime* tag "e2e_tags" rows "user_id,name") '(text text any text)))
(def (p$query-field name) (static-field dev.dreamerslab.supabase.helpers.QueryField name))
(def (p$set-query query field value)
  (call-component-method 'SupabaseDatabase1 'SetQueryField (*list-for-runtime* query field value) '(dictionary text any)))
(def (p$query tag query)
  (call-component-method 'SupabaseDatabase1 'Query (*list-for-runtime* tag "notes" query) '(text text dictionary)))

(define-event Screen1 Initialize()(set-this-form)
  (call-component-method 'Supabase1 'SignUp
    (*list-for-runtime* (string-append "e2e" (number->string (java.lang.System:currentTimeMillis)) "@example.com") "secret123" (make-yail-dictionary))
    '(text text dictionary)))

(define-event Supabase1 SessionChanged($status $user)(set-this-form)
  ((get-var p$report) (string-append "session " (coerce-to-string (lexical-value $status))))
  (if (yail-equal? (lexical-value $status) "SignedIn")
    (call-component-method 'SupabaseDatabase1 'Insert
      (*list-for-runtime* "insert" "notes" (make-yail-list (make-yail-dictionary (make-dictionary-pair "body" "first")) (make-yail-dictionary (make-dictionary-pair "body" "second, with \"quotes\""))))
      '(text text any))))

(define-event SupabaseDatabase1 GotRows($tag $rows)(set-this-form)
  (define tag (lexical-value $tag))
  (define rows (lexical-value $rows))
  ((get-var p$report) (string-append tag " " (number->string (yail-list-length rows)) " " (coerce-to-string rows)))
  (cond
    ((yail-equal? tag "insert")
      (call-component-method 'SupabaseDatabase1 'Select
        (*list-for-runtime* "select" "notes" "id,body" (make-yail-list ((get-var p$filter) "body" "in" (make-yail-list "first" "second, with \"quotes\""))) "id" #f 1 0)
        '(text text text list text boolean number number)))
    ((yail-equal? tag "select")
      (call-component-method 'SupabaseDatabase1 'Count (*list-for-runtime* "count" "notes" (make-yail-list)) '(text text list)))
    ((yail-equal? tag "update")
      (call-component-method 'SupabaseDatabase1 'Delete
        (*list-for-runtime* "delete" "notes" (make-yail-list ((get-var p$filter) "body" "eq" "changed")))
        '(text text list)))
    ((yail-equal? tag "delete")
      (call-component-method 'SupabaseDatabase1 'CallFunction (*list-for-runtime* "rpc" "note_count" (make-yail-dictionary)) '(text text dictionary)))
    ((yail-equal? tag "order")
      ((get-var p$query) "sorted" (make-yail-dictionary
        (make-dictionary-pair ((get-var p$query-field) "Columns") "id,body")
        (make-dictionary-pair ((get-var p$query-field) "Filters") (make-yail-list ((get-var p$filter) "body" "in" (make-yail-list "a" "b"))))
        (make-dictionary-pair "orderBy" "body, id desc"))))
    ((yail-equal? tag "sorted")
      ((get-var p$report) (string-append "later b first " (coerce-to-string
        (> (yail-dictionary-lookup "id" (yail-list-get-item rows 2) 0) (yail-dictionary-lookup "id" (yail-list-get-item rows 3) 0)))))
      (let ((query (make-yail-dictionary)))
        ((get-var p$set-query) query ((get-var p$query-field) "Columns") "body")
        ((get-var p$set-query) query "orderBy" "id")
        ((get-var p$set-query) query ((get-var p$query-field) "Limit") 2)
        ((get-var p$set-query) query ((get-var p$query-field) "Offset") 1)
        (call-component-method 'SupabaseDatabase1 'QueryPage (*list-for-runtime* "page" "notes" query) '(text text dictionary))))
    ((yail-equal? tag "tags")
      ((get-var p$tags) "tags again" (make-yail-list ((get-var p$tag) "x") ((get-var p$tag) "z"))))
    ((yail-equal? tag "tags again")
      (set-and-coerce-property! 'SupabaseDatabase1 'Schema "graphql_public" 'text)
      (call-component-method 'SupabaseDatabase1 'CallFunction
        (*list-for-runtime* "graphql" "graphql" (make-yail-dictionary (make-dictionary-pair "query" "{ __typename }"))) '(text text dictionary)))))

(define-event SupabaseDatabase1 GotPage($tag $rows $total)(set-this-form)
  ((get-var p$report) (string-append "page " (coerce-to-string (lexical-value $rows)) " of " (coerce-to-string (lexical-value $total))))
  (let ((query (make-yail-dictionary (make-dictionary-pair "limit" 2))))
    ((get-var p$set-query) query ((get-var p$query-field) "Limit") "lots")
    ((get-var p$report) (string-append "limit kept " (coerce-to-string (yail-dictionary-lookup "limit" query "none")))))
  ((get-var p$query) "bad key" (make-yail-dictionary (make-dictionary-pair (static-field dev.dreamerslab.supabase.helpers.FilterOperator "Equals") 1)))
  ((get-var p$query) "bad text key" (make-yail-dictionary (make-dictionary-pair "limt" 1)))
  ((get-var p$query) "bad filter" (make-yail-dictionary (make-dictionary-pair "filters" (make-yail-list (make-yail-list "body" "eq")))))
  ((get-var p$query) "bad order" (make-yail-dictionary (make-dictionary-pair "orderBy" "body sideways")))
  ((get-var p$tags) "tags" (make-yail-list ((get-var p$tag) "x") ((get-var p$tag) "y"))))

(define-event SupabaseDatabase1 GotCount($tag $count)(set-this-form)
  ((get-var p$report) (string-append "count " (coerce-to-string (lexical-value $count))))
  (call-component-method 'SupabaseDatabase1 'Update
    (*list-for-runtime* "update" "notes" (make-yail-dictionary (make-dictionary-pair "body" "changed")) (make-yail-list ((get-var p$filter) "body" "eq" "first")))
    '(text text dictionary list)))

(define-event SupabaseDatabase1 GotResult($tag $result)(set-this-form)
  ((get-var p$report) (string-append (lexical-value $tag) " " (coerce-to-string (lexical-value $result))))
  (if (yail-equal? (lexical-value $tag) "rpc")
    (call-component-method 'SupabaseDatabase1 'Insert
      (*list-for-runtime* "order" "notes" (make-yail-list (make-yail-dictionary (make-dictionary-pair "body" "b")) (make-yail-dictionary (make-dictionary-pair "body" "a")) (make-yail-dictionary (make-dictionary-pair "body" "b"))))
      '(text text any))
    (begin
      (set-and-coerce-property! 'SupabaseDatabase1 'Schema "hidden" 'text)
      (call-component-method 'SupabaseDatabase1 'Query (*list-for-runtime* "hidden" "notes" (make-yail-dictionary)) '(text text dictionary)))))

(define-event SupabaseDatabase1 Error($tag $operation $code $message)(set-this-form)
  ((get-var p$report) (string-append "error " (lexical-value $tag) " " (lexical-value $operation) " " (lexical-value $code) " " (lexical-value $message)))
  (when (yail-equal? (lexical-value $tag) "hidden")
    (set-and-coerce-property! 'SupabaseDatabase1 'Schema "" 'text)
    ((get-var p$report) (string-append "schema " (get-property 'SupabaseDatabase1 'Schema)))
    (call-component-method 'SupabaseDatabase1 'Delete (*list-for-runtime* "unfiltered" "notes" (make-yail-list)) '(text text list))
    (call-component-method 'SupabaseDatabase1 'Query (*list-for-runtime* "missing" "no_such_table" (make-yail-dictionary)) '(text text dictionary))))
