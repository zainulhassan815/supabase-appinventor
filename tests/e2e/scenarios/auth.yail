(def g$step "anonymous")
(def g$email (string-append "e2e" (number->string (java.lang.System:currentTimeMillis)) "@example.com"))
(def (p$auth method args types) (call-component-method 'Supabase1 method args types))
(def (p$update email password metadata code)
  ((get-var p$auth) 'UpdateUser (*list-for-runtime* email password metadata code) '(text text dictionary text)))
(def (p$step name) (set-var! g$step name))
(def (p$at name) (yail-equal? (get-var g$step) name))

(define-event Screen1 Initialize()(set-this-form)
  ((get-var p$auth) 'SignInAnonymously (*list-for-runtime*) '()))

(define-event Supabase1 SessionChanged($status $user)(set-this-form)
  (define status (lexical-value $status))
  (cond
    ((and (yail-equal? status "SignedIn") ((get-var p$at) "anonymous"))
      ((get-var p$report) (string-append "anonymous " (coerce-to-string (yail-dictionary-lookup "is_anonymous" (lexical-value $user) "missing"))))
      ((get-var p$step) "email")
      ((get-var p$update) (get-var g$email) "" (make-yail-dictionary) ""))
    ((and (yail-equal? status "SignedOut") ((get-var p$at) "signed out"))
      ((get-var p$step) "sign in")
      ((get-var p$auth) 'SignIn (*list-for-runtime* (get-var g$email) "secret123") '(text text)))
    ((and (yail-equal? status "SignedIn") ((get-var p$at) "sign in"))
      ((get-var p$report) "signed in with the new password")
      ((get-var p$step) "resend")
      ((get-var p$auth) 'ResendConfirmation (*list-for-runtime* (get-var g$email)) '(text)))
    ((and (yail-equal? status "SignedOut") ((get-var p$at) "signed out again"))
      ((get-var p$update) "" "another123" (make-yail-dictionary) ""))))

(define-event Supabase1 UserUpdated($user)(set-this-form)
  (define user (lexical-value $user))
  (cond
    (((get-var p$at) "email")
      ((get-var p$report) (string-append "email changed " (coerce-to-string (yail-equal? (yail-dictionary-lookup "email" user "") (get-var g$email)))
        " anonymous " (coerce-to-string (yail-dictionary-lookup "is_anonymous" user "missing"))))
      ((get-var p$step) "password")
      ((get-var p$update) "" "secret123" (make-yail-dictionary (make-dictionary-pair "name" "Zed")) ""))
    (((get-var p$at) "password")
      ((get-var p$report) (string-append "metadata name " (yail-dictionary-lookup "name" (yail-dictionary-lookup "user_metadata" user (make-yail-dictionary)) "missing")))
      ((get-var p$step) "signed out")
      ((get-var p$auth) 'SignOut (*list-for-runtime*) '()))))

(define-event Supabase1 MessageSent($operation)(set-this-form)
  ((get-var p$report) (string-append "sent " (lexical-value $operation)))
  (if (yail-equal? (lexical-value $operation) "ResendConfirmation")
    ((get-var p$auth) 'Reauthenticate (*list-for-runtime*) '())
    (begin
      ((get-var p$step) "signed out again")
      ((get-var p$auth) 'SignOut (*list-for-runtime*) '()))))

(define-event Supabase1 Error($operation $code $message)(set-this-form)
  ((get-var p$report) (string-append "error " (lexical-value $operation) " " (lexical-value $code))))
