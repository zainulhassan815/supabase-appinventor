(def g$step "unknown")
(def g$code "")
(def g$email (string-append "e2e" (number->string (java.lang.System:currentTimeMillis)) "@example.com"))
(def g$phone "+15550100001")
(def (p$auth method args types) (call-component-method 'Supabase1 method args types))
(def (p$step name) (set-var! g$step name))
(def (p$at name) (yail-equal? (get-var g$step) name))
(def (p$send-email-code create)
  ((get-var p$auth) 'SendEmailCode (*list-for-runtime* (get-var g$email) create) '(text boolean)))
(def (p$verify-email code type)
  ((get-var p$auth) 'VerifyEmailCode (*list-for-runtime* (get-var g$email) code type) '(text text text)))
(def (p$read-mail)
  (set-and-coerce-property! 'Mailpit 'Url
    (string-append "http://127.0.0.1:54324/api/v1/search?query=to:" (call-component-method 'Mailpit 'UriEncode (*list-for-runtime* (get-var g$email)) '(text)))
    'text)
  (call-component-method 'Mailpit 'Get (*list-for-runtime*) '()))
(def (p$code-in snippet)
  (string-substring (yail-list-get-item (string-split snippet "code: ") 2) 1 6))

(define-event Screen1 Initialize()(set-this-form)
  ((get-var p$send-email-code) #f))

(define-event Supabase1 MessageSent($operation)(set-this-form)
  ((get-var p$report) (string-append "sent " (lexical-value $operation)))
  (if (yail-equal? (lexical-value $operation) "SendSmsCode")
    (begin
      ((get-var p$step) "sms")
      ((get-var p$auth) 'VerifySmsCode (*list-for-runtime* (get-var g$phone) "123456") '(text text)))
    ((get-var p$read-mail))))

(define-event Mailpit GotText($url $responseCode $responseType $responseContent)(set-this-form)
  (define messages (yail-dictionary-lookup "messages" (call-component-method 'Mailpit 'JsonTextDecodeWithDictionaries (*list-for-runtime* (lexical-value $responseContent)) '(text)) (make-yail-list)))
  (set-var! g$code ((get-var p$code-in) (yail-dictionary-lookup "Snippet" (yail-list-get-item messages 1) "")))
  ((get-var p$report) (string-append "code has " (number->string (string-length (get-var g$code))) " digits"))
  (if ((get-var p$at) "send")
    (begin
      ((get-var p$step) "wrong code")
      ((get-var p$verify-email) "000000" "email"))
    (begin
      ((get-var p$step) "reset")
      ((get-var p$verify-email) (get-var g$code) "recovery"))))

(define-event Supabase1 SessionChanged($status $user)(set-this-form)
  (define status (lexical-value $status))
  (define user (lexical-value $user))
  (cond
    ((and (yail-equal? status "SignedIn") ((get-var p$at) "verify"))
      ((get-var p$report) (string-append "signed in with an email code " (yail-dictionary-lookup "email" user "")))
      ((get-var p$step) "signed out")
      ((get-var p$auth) 'SignOut (*list-for-runtime*) '()))
    ((and (yail-equal? status "SignedOut") ((get-var p$at) "signed out"))
      ((get-var p$step) "reset mail")
      ((get-var p$auth) 'ResetPassword (*list-for-runtime* (get-var g$email)) '(text)))
    ((and (yail-equal? status "SignedIn") ((get-var p$at) "reset"))
      ((get-var p$report) "signed in with a reset code")
      ((get-var p$step) "new password")
      ((get-var p$auth) 'UpdateUser (*list-for-runtime* "" "newpass123" (make-yail-dictionary) "") '(text text dictionary text)))
    ((and (yail-equal? status "SignedOut") ((get-var p$at) "after reset"))
      ((get-var p$step) "password")
      ((get-var p$auth) 'SignIn (*list-for-runtime* (get-var g$email) "newpass123") '(text text)))
    ((and (yail-equal? status "SignedIn") ((get-var p$at) "password"))
      ((get-var p$report) "signed in with the new password")
      ((get-var p$auth) 'SendSmsCode (*list-for-runtime* (get-var g$phone) #t) '(text boolean)))
    ((and (yail-equal? status "SignedIn") ((get-var p$at) "sms"))
      ((get-var p$report) (string-append "signed in with an sms code " (yail-dictionary-lookup "phone" user ""))))))

(define-event Supabase1 UserUpdated($user)(set-this-form)
  ((get-var p$step) "after reset")
  ((get-var p$auth) 'SignOut (*list-for-runtime*) '()))

(define-event Supabase1 Error($operation $code $message)(set-this-form)
  (if (yail-equal? (lexical-value $code) "over_email_send_rate_limit")
    ((get-var p$auth) (string->symbol (lexical-value $operation)) (*list-for-runtime* (get-var g$email)) '(text))
    ((get-var p$report) (string-append "error " (lexical-value $operation) " " (lexical-value $code))))
  (cond
    (((get-var p$at) "unknown")
      ((get-var p$step) "send")
      ((get-var p$send-email-code) #t))
    (((get-var p$at) "wrong code")
      ((get-var p$step) "verify")
      ((get-var p$verify-email) (get-var g$code) "email"))))
